# ============================================================================
# YURSINALIEV.COM — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Platform: Muhammadaziz Yursinaliyev (Bio-Cyber Minimal)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (Safe to expose in client bundles)
# ----------------------------------------------------------------------------

# Your Supabase Project API URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous Key (Protected by PostgreSQL Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Canonical Production URL of the Platform
NEXT_PUBLIC_APP_URL=https://yursinaliev.com

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production


# ----------------------------------------------------------------------------
# 2. PRIVATE SERVER-SIDE SECRETS (NEVER expose to client bundles or git)
# ----------------------------------------------------------------------------

# Supabase Service Role Key (Required ONLY for administrative Server Actions & background jobs)
# CAUTION: Bypasses RLS. Keep strictly secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct PostgreSQL Connection String (Transaction Pooler - port 6543 or Session - port 5432)
# Required for database migrations and ORM tooling.
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Connection String (Used for running migrations without connection pooler)
DIRECT_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres


# ----------------------------------------------------------------------------
# 3. OPTIONAL THIRD-PARTY INTEGRATIONS
# ----------------------------------------------------------------------------

# Google OAuth Redirect URL (Optional override if behind custom proxy)
SUPABASE_OAUTH_REDIRECT_URL=https://yursinaliev.com/auth/callback

# Upstash Redis (Optional for global Edge rate limiting)
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
